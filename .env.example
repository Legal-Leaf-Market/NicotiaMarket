# Copy to .env for local dev. NEVER commit the real values — .env* is
# gitignored. In production these are set in Vercel → Project →
# Settings → Environment Variables.

# AWIN product feeds. One key covers every AWIN advertiser; each store
# then needs its own `feedId` in the registry in api/products.js.
# Find it under Toolbox → Create-a-Feed in the AWIN dashboard.
# NOTE: the feed id is NOT the advertiser id. They are different
# numbers and swapping them returns a different merchant's catalogue.
AWIN_API_KEY=

# Optional. Forward /api/subscribe signups to an Apps Script /exec URL.
NM_CRM_WEBHOOK=

# Optional. Forward /api/track events.
NM_EVENTS_WEBHOOK=

# Both required for /api/notify (the "batch ready for approval" email —
# see SEO_AUDIT_LOG.md). Get RESEND_API_KEY from resend.com; NM_NOTIFY_TOKEN
# is any secret string you choose — pass it back as x-notify-token or
# ?token= when calling the endpoint.
RESEND_API_KEY=
NM_NOTIFY_TOKEN=
