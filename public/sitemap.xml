<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-maintained: there is no build step, so this does not generate
  itself. If you add a department route to vercel.json, add it here too.
  Product URLs are deliberately absent — every product lives on the
  vendor's own site and we should never compete with them for it.
-->
